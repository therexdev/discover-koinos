{
    "methods": {
        "create_market": {
            "input": "orderbook.create_market_arguments",
            "output": "orderbook.create_market_result",
            "description": "Create a new trading market between two tokens. Permissionless: anyone may list a pair; the transaction payer covers the mana. Both addresses must answer decimals() like a live token contract",
            "entryPoint": 807604807,
            "readOnly": false
        },
        "set_min_base_amount": {
            "input": "orderbook.set_min_base_amount_arguments",
            "output": "orderbook.set_min_base_amount_result",
            "description": "Adjust a market's minimum order size (contract authority only; repair hatch for unusable permissionless listings)",
            "entryPoint": 3440789165,
            "readOnly": false
        },
        "place_order": {
            "input": "orderbook.place_order_arguments",
            "output": "orderbook.place_order_result",
            "description": "Place a limit order. Crossing orders are matched immediately with price-time priority; any remainder is escrowed on the book (GTC), refunded (IOC) or the call fails (POST_ONLY if it would cross)",
            "entryPoint": 372990117,
            "readOnly": false
        },
        "cancel_order": {
            "input": "orderbook.cancel_order_arguments",
            "output": "orderbook.cancel_order_result",
            "description": "Cancel an open order and refund its escrow (order owner authority)",
            "entryPoint": 2218931612,
            "readOnly": false
        },
        "get_markets": {
            "input": "orderbook.get_markets_arguments",
            "output": "orderbook.get_markets_result",
            "description": "Get all markets with their stats",
            "entryPoint": 2944069267,
            "readOnly": true
        },
        "get_orderbook": {
            "input": "orderbook.get_orderbook_arguments",
            "output": "orderbook.get_orderbook_result",
            "description": "Get the resting orders of a market orderbook, best priced first",
            "entryPoint": 1161772971,
            "readOnly": true
        },
        "get_order": {
            "input": "orderbook.get_order_arguments",
            "output": "orderbook.get_order_result",
            "description": "Get a single open order by id",
            "entryPoint": 1167154361,
            "readOnly": true
        },
        "get_user_orders": {
            "input": "orderbook.get_user_orders_arguments",
            "output": "orderbook.get_user_orders_result",
            "description": "Get the open orders of an account, ordered by ascending order id",
            "entryPoint": 1262709602,
            "readOnly": true
        },
        "get_trades": {
            "input": "orderbook.get_trades_arguments",
            "output": "orderbook.get_trades_result",
            "description": "Get the most recent trades of a market, newest first",
            "entryPoint": 3023924143,
            "readOnly": true
        }
    },
